# LoanManager Environment Variables
DJANGO_ENV=local
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL Neon / Local)
# If empty in local mode, SQLite will be used as a convenient fallback.
DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/loanmanager?sslmode=require

# Application Settings
SYSTEM_NAME=LoanManager
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@loanmanager.local
TIME_ZONE=America/Bogota
CURRENCY_CODE=COP

# Resend Email Service (Free tier available)
RESEND_API_KEY=re_your_api_key_here
DEFAULT_FROM_EMAIL=LoanManager <notificaciones@loanmanager.local>

