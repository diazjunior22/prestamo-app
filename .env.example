# LoanManager Environment Variables
DJANGO_ENV=local
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL Neon / Local)
# If empty in local mode, SQLite will be used as a convenient fallback.
DATABASE_URL=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/loanmanager?sslmode=require

# Application Settings
SYSTEM_NAME=LoanManager
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@loanmanager.local
TIME_ZONE=America/Bogota
CURRENCY_CODE=COP

# Configuración de Correo Gratuito con Gmail SMTP (Google App Password)
# 1. En tu cuenta de Google, activa la 'Verificación en 2 pasos'.
# 2. Ve a https://myaccount.google.com/apppasswords y crea una contraseña de aplicación (App Password).
# 3. Copia el código de 16 caracteres generado (sin espacios) y pégalo abajo.
# 4. Es 100% gratuito y permite enviar hasta 500 correos al día por cuenta de Gmail.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_cuenta@gmail.com
EMAIL_HOST_PASSWORD=abcd1234efgh5678
DEFAULT_FROM_EMAIL=LoanManager <tu_cuenta@gmail.com>


